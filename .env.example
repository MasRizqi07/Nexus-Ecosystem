# ===============================================
# NEXUS ECOSYSTEM — ENVIRONMENT VARIABLES
# ===============================================

# [Auth]
# REQUIRED in every environment, including local dev. No default exists — the app
# will not start without it. Generate one with: openssl rand -base64 32
AUTH_SECRET="<generate-your-own-32+-char-secret-do-not-reuse-this-example>"

# [Database Persistence]
# Optional during development (system falls back safely to in-memory singleton).
# Required for multi-instance production (Neon, Supabase, AWS RDS, etc.).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus_db"

# [App Environment]
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
